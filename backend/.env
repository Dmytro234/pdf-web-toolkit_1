# Flask environment: development | production | testing
FLASK_ENV=development

# Secret key for session signing, csrf, etc.
SECRET_KEY=change-me-to-a-long-random-string

# Flask-Session backend type (filesystem recommended for MVP)
SESSION_TYPE=filesystem

# Temporary directory for uploaded/intermediate files
TEMP_DIR=./.tmp

# Limits
MAX_FILE_SIZE_MB=200
MAX_SESSION_SIZE_MB=250
MAX_FILES_PER_SESSION=20

# Cleanup job settings
CLEANUP_INTERVAL_MINUTES=10
FILE_TTL_HOURS=6

# CORS allowed origins (comma-separated). Use * only for local dev if needed.
CORS_ORIGINS=http://localhost:5173

# Backend port
PORT=5000